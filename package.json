{
  "name": "flowboard",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative kanban board: React, TypeScript and Node.js in a pnpm workspace",
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
