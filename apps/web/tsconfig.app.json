// App code (src/, browser). Type-check only: Vite transpiles the sources.
{
  "compilerOptions": {
    // tsc -b's incremental cache, kept out of the source tree.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    // import.meta.env and imports of non-code assets (CSS, SVG).
    "types": ["vite/client"],

    "module": "esnext",
    "moduleResolution": "bundler",
    // Imports name the .tsx file, as in the API; allowed because nothing is emitted.
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    // Vite transpiles each file in isolation: type-only imports must be explicit.
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // No enum or namespace: string-literal unions instead.
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
