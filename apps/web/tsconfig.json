// One project per runtime, so browser code cannot use Node APIs and vice versa:
//   tsconfig.app.json  → src/, browser
//   tsconfig.node.json → vite.config.ts, Node
// `tsc -b` (`pnpm typecheck`, `pnpm build`) checks both.
{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
