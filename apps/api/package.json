{
  "name": "@flowboard/api",
  "version": "0.1.0",
  "private": true,
  "description": "Flowboard REST API: Node.js, Express, TypeScript, PostgreSQL with Prisma",
  "type": "module",
  "scripts": {
    "dev": "prisma generate --no-hints && tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate --no-hints && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "prisma generate --no-hints && tsc --noEmit && tsc --noEmit -p test",
    "test": "prisma generate --no-hints && vitest run",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:studio": "prisma studio --port 6255"
  },
  "dependencies": {
    "@flowboard/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
