// API: type-checked by `pnpm typecheck`, compiled to dist/ by `pnpm build`.
// tsx runs the sources in development without type-checking.
// https://www.typescriptlang.org/tsconfig
{
  "compilerOptions": {
    // Node 24 runs ES2023 natively.
    "target": "es2023",
    // No DOM: browser globals must not type-check on the server.
    "lib": ["ES2023"],
    // TypeScript 6 loads no @types packages implicitly.
    "types": ["node"],

    "module": "nodenext",
    // Imports name the .ts file; tsc rewrites them to .js in dist/.
    "rewriteRelativeImportExtensions": true,
    // Explicit type-only imports, so tsx can drop them file by file.
    "verbatimModuleSyntax": true,
    // No enum, namespace or parameter properties: the subset Node's type stripping accepts.
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",

    "rootDir": "src",
    "outDir": "dist",
    // Stack traces point at the .ts sources when Node runs with --enable-source-maps.
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Prefix an unused but required parameter with "_" (e.g. `_req`).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
