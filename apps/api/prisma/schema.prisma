// Flowboard's database schema (PostgreSQL). A change here needs a migration: pnpm db:migrate.

generator client {
  provider = "prisma-client"
  // Generated TypeScript, compiled with the API's sources; gitignored, rebuilt by every API script.
  output   = "../src/generated/prisma"
}

// The URL comes from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// Mirrors paletteColors in @flowboard/shared.
enum PaletteColor {
  gray
  coral
  red
  amber
  green
  blue
  violet
}

model Board {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  columns   Column[]
  labels    Label[]
  members   Member[]
}

// Positions order siblings (columns on a board, cards in a column); gaps are allowed.
model Column {
  id       String       @id @default(cuid())
  board    Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId  String
  title    String
  color    PaletteColor
  position Int
  cards    Card[]

  @@index([boardId, position])
}

model Card {
  id          String    @id @default(cuid())
  column      Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  title       String
  description String    @default("")
  // A calendar day with no time zone; Prisma reads it as midnight UTC.
  dueDate     DateTime? @db.Date
  position    Int
  labels      Label[]
  assignees   Member[]
  comments    Comment[]

  @@index([columnId, position])
}

// A board's labels, in the order cards show them.
model Label {
  id       String       @id @default(cuid())
  board    Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId  String
  name     String
  color    PaletteColor
  position Int
  cards    Card[]

  @@index([boardId])
}

// An account. The email is stored trimmed and lowercased, so the unique index ignores case.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // scrypt, with its parameters and salt: src/auth/passwords.ts.
  passwordHash String
  createdAt    DateTime @default(now())
  members      Member[]
  sessions     Session[]
}

// A signed-in browser: src/auth/sessions.ts. The cookie holds the token, the table only its hash.
model Session {
  // SHA-256 of the cookie's token, hex: a copy of the table cannot sign anyone in.
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  // Pushed back while the session is used, never past createdAt plus the absolute limit.
  expiresAt DateTime

  @@index([userId])
}

// Someone who works on a board, linked to their account once they have one. A deleted account
// leaves the member, so their name stays on their comments and cards.
model Member {
  id       String    @id @default(cuid())
  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId  String
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId   String?
  name     String
  color    PaletteColor
  cards    Card[]
  comments Comment[]

  // Also serves the lookups by board, so boardId needs no index of its own.
  @@unique([boardId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  // NoAction: a member cannot be deleted before their comments. Neither can a board that has any:
  // its cascade reaches the members before the comments, under columns and cards. Delete them first.
  author    Member   @relation(fields: [authorId], references: [id], onDelete: NoAction)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
  @@index([authorId])
}
