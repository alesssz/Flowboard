# The API's environment: copy to .env (gitignored) and adjust.

# PostgreSQL connection, read by the API, the Prisma CLI and the seed.
# Matches the db service in compose.yaml (pnpm db:up).
DATABASE_URL=postgresql://flowboard:flowboard@localhost:6132/flowboard

# Port the API listens on; the web app's dev proxy targets 3700.
# PORT=3700

# Interface the API listens on: 127.0.0.1 keeps it off the network; 0.0.0.0 in a container.
# HOST=127.0.0.1

# Host names the API answers besides localhost, 127.0.0.1 and [::1]: comma-separated, without port.
# ALLOWED_HOSTS=flowboard.example